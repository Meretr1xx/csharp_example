{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=project_tracker_db;Username=postgres;Password=postgres"
  },

  "Session": {
    "IdleTimeoutMinutes": 30,
    "CookieName": "ProjectTracker.Session",
    "HttpOnly": true,
    "IsEssential": true
  },

  "Authentication": {
    "CookieName": "ProjectTracker.Auth",
    "LoginPath": "/Account/Login",
    "AccessDeniedPath": "/Account/AccessDenied",
    "ExpireHours": 2,
    "SlidingExpiration": true
  }
}
