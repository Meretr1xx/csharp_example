@model Project_tracker.Models.Project

@{
    ViewData["Title"] = "Создание проекта";
}

<div class="container mt-4">
    <h2>Создание нового проекта</h2>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Название проекта
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Описание
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">
                        Дата начала
                    </label>
                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">
                        Дата окончания
                    </label>
                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="OwnerId" class="form-label">
                        Владелец проекта
                    </label>
                    <select asp-for="OwnerId"
                            asp-items="ViewBag.OwnerId"
                            class="form-select">
                        <option value="">Выберите владельца</option>
                    </select>
                    <span asp-validation-for="OwnerId"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Создать проект
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Назад
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}